// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  /// WhatsApp do cadastro, só dígitos com DDI ("5511987654321"). Nullable por
  /// causa das contas anteriores ao campo, e não é unique: a mesma pessoa pode
  /// abrir mais de uma conta.
  whatsapp      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart      DateTime           @default(now())
  dmsSentThisPeriod     Int                @default(0)
  subscriptionStatus    SubscriptionStatus @default(NONE)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  stripePriceId         String?
  subscriptionPeriodEnd DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  leads             Lead[]
  leadEvents        LeadEvent[]
  sales             Sale[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  billingEvents     BillingEvent[]

  @@index([ownerId])
}

model BillingEvent {
  id            String    @id @default(cuid())
  workspaceId   String?
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]      @relation("LeadAssignee")
  leadEvents    LeadEvent[] @relation("LeadEventActor")

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  instagramId       String    @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean   @default(false)
  connectedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations       Automation[]
  dmLogs            DmLog[]
  leads             Lead[]
  linkClicks        LinkClick[]
  followerSnapshots FollowerSnapshot[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name                    String
  goal                    String?
  postId                  String?
  postUrl                 String?
  pendingNextReel         Boolean  @default(false)
  matchAnyPost            Boolean  @default(false)
  keywords                String[]
  matchAnyWord            Boolean  @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled        Boolean  @default(false)
  dmMessage               String
  openingDmEnabled        Boolean  @default(false)
  openingDmMessage        String?
  openingDmButtonLabel    String?
  linkButtonLabel         String?
  requireFollow           Boolean  @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled         Boolean  @default(false)
  followUpMessage         String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes    Int      @default(0)
  publicReplyEnabled      Boolean  @default(false)
  publicReplyMessage      String?
  publicReplyMessages     String[] @default([])
  isActive                Boolean  @default(false)
  wholeWordMatch          Boolean  @default(true)
  reportShareSlug         String?  @unique
  reportShareEnabled      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  sourcedLeads     Lead[]           @relation("LeadSourceAutomation")

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

// O estado comercial de uma pessoa que interagiu com a conta.
//
// Lead é a oportunidade comercial canônica. Sinais automáticos guardam sua
// proveniência, correções humanas não são sobrescritas pelo worker e receita só
// existe no ledger Sale — nunca inferida do estágio do pipeline.
model Lead {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  // Mesma chave de pessoa usada pelo mapa de calor: o par (conta, comentarista).
  commenterId   String
  commenterName String?

  status          LeadStatus @default(NOVO)
  note            String?
  lastContactedAt DateTime?

  assigneeMemberId            String?
  assigneeWorkspaceId         String?
  sourceAutomationId          String?
  sourceAutomationWorkspaceId String?
  originType                  LeadOriginType?
  originCommentId             String?
  originMessageId             String?
  originPostId                String?
  originKeyword               String?
  originText                  String?
  productOffer                String?
  potentialValueCents         Int?
  nextAction                  String?
  nextActionAt                DateTime?
  lossReason                  String?
  newAt                       DateTime?           @default(now())
  approachedAt                DateTime?
  respondedAt                 DateTime?
  negotiatingAt               DateTime?
  wonAt                       DateTime?
  lostAt                      DateTime?
  intentCategory              LeadIntentCategory?
  intentSignals               String[]            @default([])
  intentSource                LeadIntentSource?
  intentCorrectedAt           DateTime?
  version                     Int                 @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  assignee         WorkspaceMember? @relation("LeadAssignee", fields: [assigneeMemberId, assigneeWorkspaceId], references: [id, workspaceId], onDelete: SetNull)
  sourceAutomation Automation?      @relation("LeadSourceAutomation", fields: [sourceAutomationId, sourceAutomationWorkspaceId], references: [id, workspaceId], onDelete: SetNull)
  events           LeadEvent[]
  sales            Sale[]

  @@unique([instagramAccountId, commenterId])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, status, updatedAt, id])
  @@index([workspaceId, assigneeMemberId, nextActionAt])
  @@index([workspaceId, sourceAutomationId])
}

model LeadEvent {
  id                 String        @id @default(cuid())
  workspaceId        String
  leadId             String
  type               LeadEventType
  fromStatus         LeadStatus?
  toStatus           LeadStatus?
  actorMemberId      String?
  actorWorkspaceId   String?
  sourceEventKey     String
  requestFingerprint String?
  metadata           Json?
  occurredAt         DateTime      @default(now())
  createdAt          DateTime      @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead             @relation(fields: [leadId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  actor     WorkspaceMember? @relation("LeadEventActor", fields: [actorMemberId, actorWorkspaceId], references: [id, workspaceId], onDelete: SetNull)

  @@unique([workspaceId, sourceEventKey])
  @@index([workspaceId, leadId, occurredAt])
  @@index([workspaceId, type, occurredAt])
}

model Sale {
  id             String     @id @default(cuid())
  workspaceId    String
  leadId         String
  status         SaleStatus @default(CONFIRMED)
  amountCents    Int
  currency       String     @db.Char(3)
  source         SaleSource @default(MANUAL)
  confirmedAt    DateTime
  voidedAt       DateTime?
  idempotencyKey String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, confirmedAt])
  @@index([workspaceId, leadId])
}

model DmLog {
  id                 String @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId    String
  commenterName  String?
  commentText    String
  commentId      String
  matchedKeyword String?
  status         DmStatus  @default(PENDING)
  attempts       Int       @default(0)
  dmSentAt       DateTime?
  errorMessage   String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  object       String?
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                 @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel  @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  NONE
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  PAUSED
  CANCELED
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum LeadStatus {
  NOVO
  ABORDADO
  RESPONDEU
  NEGOCIANDO
  GANHO
  PERDIDO
}

enum LeadOriginType {
  COMMENT
  DIRECT_MESSAGE
  MANUAL
}

enum LeadIntentCategory {
  PRICE
  LINK
  PURCHASE
  QUESTION
  OBJECTION
  COMPARISON
  URGENCY
  STRONG_INTEREST
  SUPPORT
  NO_COMMERCIAL_INTENT
  UNKNOWN
}

enum LeadIntentSource {
  RULE
  HUMAN
  AI
}

enum LeadEventType {
  OBSERVED_COMMENT
  OBSERVED_DM
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  COMMERCIAL_FIELDS_UPDATED
  INTENT_CLASSIFIED
  INTENT_CORRECTED
  SALE_CONFIRMED
  SALE_VOIDED
}

enum SaleStatus {
  CONFIRMED
  VOIDED
}

enum SaleSource {
  MANUAL
  API
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
